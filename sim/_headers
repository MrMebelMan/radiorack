# Response headers for the deployed site (Cloudflare static assets).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
  Cache-Control: no-cache

/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
